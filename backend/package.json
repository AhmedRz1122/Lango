{
  "name": "lango-genkit-backend",
  "version": "1.0.0",
  "description": "Genkit AI backend for Lango translation app with HY-MT1.5 offline support",
  "type": "module",
  "scripts": {
    "dev": "node api.js && tsx watch src/index.ts",
    "start": "node api.js && tsx src/index.ts",
    "build": "node api.js && tsc",
    "genkit:start": "genkit start -- tsx src/index.ts"
  },
  "dependencies": {
    "@genkit-ai/express": "^1.0.0",
    "@genkit-ai/google-genai": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "genkit": "^1.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
